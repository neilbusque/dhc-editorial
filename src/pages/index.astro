---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { COMPANY } from "../consts";
import { sortByDate } from "../components/sortByDate";

const projects = (await getCollection("projects")).sort(sortByDate);
const journal  = (await getCollection("journal")).sort(sortByDate);
const gallery  = (await getCollection("gallery")).sort(sortByDate);

const featured = projects[0];
const otherProjects = projects.slice(1, 4);
const journalRecent = journal.slice(0, 3);
const galleryStrip = gallery.slice(0, 5);
---

<BaseLayout title="Home" description={COMPANY.tagline}>

  <!-- ─── Hero ───────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-text">
      <div class="eyebrow">{COMPANY.shortName} · {COMPANY.city}, {COMPANY.state}</div>
      <h1 class="display-hero">
        Homes <em>made slowly</em>,<br/>
        finished to last.
      </h1>
      <p class="lede">{COMPANY.tagline} We design and build kitchens, baths, and whole-home renovations across {COMPANY.serviceArea} — one project at a time.</p>
      <div class="cta-row">
        <a href="/projects/" class="btn-primary">See recent work</a>
        <a href="#contact"   class="btn-ghost">Start a project</a>
      </div>
    </div>

    {featured?.data?.image?.src && (
      <a href={`/projects/${featured.id}`} class="hero-image hero-frame">
        <Image
          src={featured.data.image.src}
          alt={featured.data.image.alt}
          width={1600}
          height={2000}
          loading="eager"
          format="webp"
          quality={85}
          inferSize={false}
          class="object-cover w-full h-full"
        />
        <div class="hero-caption">
          <span class="eyebrow">Featured project</span>
          <h3>{featured.data.title}</h3>
        </div>
      </a>
    )}
  </section>

  <!-- ─── Ledger strip ───────────────────────────────── -->
  <section class="ledger">
    <div><strong>{new Date().getFullYear() - COMPANY.founded}+</strong><span>years building</span></div>
    <div><strong>{projects.length}+</strong><span>completed remodels</span></div>
    <div><strong>1</strong><span>project at a time</span></div>
    <div><strong>{COMPANY.serviceArea}</strong><span>service area</span></div>
  </section>

  <!-- ─── Recent projects grid ───────────────────────── -->
  {otherProjects.length > 0 && (
    <section class="block">
      <div class="block-head">
        <span class="eyebrow">Selected projects</span>
        <a href="/projects/" class="editorial small">View all →</a>
      </div>
      <div class="project-grid">
        {otherProjects.map((p, i) => (
          <a href={`/projects/${p.id}`} class={`project-card card-editorial card-${i}`}>
            {p.data?.image?.src && (
              <Image
                src={p.data.image.src}
                alt={p.data.image.alt || p.data.title}
                width={900}
                height={1200}
                format="webp"
                quality={82}
                class="object-cover w-full h-full"
              />
            )}
            <div class="project-meta">
              <span class="eyebrow">{p.data.tags?.[0] || "Project"}</span>
              <h3>{p.data.title}</h3>
              <p class="small">{p.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ─── Process band ───────────────────────────────── -->
  <section class="process">
    <span class="eyebrow">How we work</span>
    <h2 class="process-title"><em>Three rooms.</em> One year. Twenty meetings. Every drawer where you'd open it.</h2>
    <ol class="steps">
      <li>
        <span class="step-num">01</span>
        <h4>Listen &amp; measure</h4>
        <p>Two-hour walkthrough, hand sketches, honest estimate ranges. No high-pressure quote.</p>
      </li>
      <li>
        <span class="step-num">02</span>
        <h4>Design &amp; specify</h4>
        <p>Drawings, finishes, fixtures. We source from suppliers we know — no boilerplate.</p>
      </li>
      <li>
        <span class="step-num">03</span>
        <h4>Build &amp; close out</h4>
        <p>One crew per project. Same lead from demo to punch list. Photographs when we're done.</p>
      </li>
    </ol>
  </section>

  <!-- ─── Journal recent ──────────────────────────────── -->
  {journalRecent.length > 0 && (
    <section class="block">
      <div class="block-head">
        <span class="eyebrow">Field notes</span>
        <a href="/journal/" class="editorial small">All journal entries →</a>
      </div>
      <div class="journal-grid">
        {journalRecent.map((j) => (
          <a href={`/journal/${j.id}`} class="journal-card card-editorial">
            {j.data?.image?.src && (
              <Image
                src={j.data.image.src}
                alt={j.data.image.alt || j.data.title}
                width={700}
                height={520}
                format="webp"
                quality={80}
                class="object-cover w-full h-56"
              />
            )}
            <div class="journal-meta">
              <span class="small mono">{new Date(j.data.pubDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span>
              <h3>{j.data.title}</h3>
              <p class="small">{j.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ─── Gallery strip ──────────────────────────────── -->
  {galleryStrip.length > 0 && (
    <section class="gallery-strip">
      <div class="block-head">
        <span class="eyebrow">Recent gallery</span>
        <a href="/gallery/" class="editorial small">Browse the gallery →</a>
      </div>
      <div class="strip">
        {galleryStrip.map((g) => (
          g.data?.image?.src && (
            <a href={`/gallery/${g.id}`} class="strip-item card-editorial">
              <Image
                src={g.data.image.src}
                alt={g.data.image.alt || g.data.title}
                width={500}
                height={700}
                format="webp"
                quality={80}
                class="object-cover w-full h-full"
              />
            </a>
          )
        ))}
      </div>
    </section>
  )}

  <!-- ─── CTA ─────────────────────────────────────────── -->
  <section id="contact" class="cta-band">
    <div>
      <span class="eyebrow">Starting a project?</span>
      <h2><em>We take on a handful</em> of renovations each year. Tell us what you're imagining.</h2>
    </div>
    <div class="cta-actions">
      <a href={`tel:+19085550100`} class="btn-primary">Call {COMPANY.phone}</a>
      <a href={`mailto:${COMPANY.email}`} class="btn-ghost">Email the studio</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────────────
     HERO
     ────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding: 4rem 0 5rem;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 5rem;
      padding: 6rem 0 7rem;
    }
  }
  .hero-text { display: flex; flex-direction: column; justify-content: center; }
  .display-hero {
    font-family: var(--font-fraunces), serif;
    font-size: clamp(2.75rem, 7vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 1.25rem 0 1.75rem;
  }
  .display-hero em {
    font-style: italic;
    color: var(--color-clay);
    font-weight: 360;
  }
  .lede {
    font-family: var(--font-fraunces), serif;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--color-ink-2);
    max-width: 36rem;
    margin-bottom: 2rem;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero-image {
    display: block;
    aspect-ratio: 4 / 5;
    position: relative;
    overflow: hidden;
  }
  .hero-caption {
    position: absolute;
    bottom: 1.25rem; left: 1.5rem; right: 1.5rem;
    color: var(--color-cream);
    z-index: 2;
  }
  .hero-caption .eyebrow {
    color: rgba(244,239,230,0.85);
  }
  .hero-caption h3 {
    color: var(--color-cream);
    font-size: 1.4rem;
    margin-top: 0.4rem;
  }

  /* ──────────────────────────────────────────────
     LEDGER
     ────────────────────────────────────────────── */
  .ledger {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 900px) { .ledger { grid-template-columns: repeat(4, 1fr); } }
  .ledger div { display: flex; flex-direction: column; gap: 0.35rem; }
  .ledger strong {
    font-family: var(--font-fraunces), serif;
    font-style: italic;
    font-weight: 460;
    font-size: 1.75rem;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .ledger span {
    font-family: var(--font-inter), sans-serif;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-2);
  }

  /* ──────────────────────────────────────────────
     BLOCK / GRIDS
     ────────────────────────────────────────────── */
  .block { padding: 5rem 0; }
  .block-head {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 2.5rem;
  }
  .small { font-size: 0.92rem; line-height: 1.55; color: var(--color-ink-2); }
  .small.mono { font-family: var(--font-jetbrains-mono), monospace; font-size: 0.72rem; letter-spacing: 0.04em; }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .project-grid { grid-template-columns: repeat(3, 1fr); gap: 3rem; }
  }
  .project-card {
    text-decoration: none;
    color: inherit;
  }
  .project-card .object-cover {
    aspect-ratio: 3 / 4;
  }
  /* Asymmetric variation — each card sits at a different vertical offset so the grid feels less templated */
  @media (min-width: 900px) {
    .card-0 { transform: translateY(0); }
    .card-1 { transform: translateY(3rem); }
    .card-2 { transform: translateY(-1rem); }
  }
  .project-meta { padding-top: 1.25rem; }
  .project-meta h3 {
    margin-top: 0.35rem;
    font-size: 1.4rem;
  }

  /* ──────────────────────────────────────────────
     PROCESS
     ────────────────────────────────────────────── */
  .process {
    padding: 5rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .process-title {
    margin: 1.25rem 0 3rem;
    max-width: 30ch;
    font-size: clamp(1.9rem, 4vw, 2.85rem);
  }
  .process-title em { color: var(--color-clay); font-style: italic; }
  .steps {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 900px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }
  .steps li {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .step-num {
    font-family: var(--font-jetbrains-mono), monospace;
    font-size: 0.72rem; letter-spacing: 0.1em;
    color: var(--color-clay);
  }
  .steps h4 {
    font-family: var(--font-fraunces), serif;
    font-size: 1.4rem; font-weight: 460;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.01em;
  }
  .steps p { color: var(--color-ink-2); line-height: 1.55; }

  /* ──────────────────────────────────────────────
     JOURNAL
     ────────────────────────────────────────────── */
  .journal-grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 900px) {
    .journal-grid { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  }
  .journal-card { text-decoration: none; color: inherit; }
  .journal-meta { padding: 1.25rem 0 0; }
  .journal-meta h3 { font-size: 1.25rem; margin: 0.5rem 0 0.5rem; }

  /* ──────────────────────────────────────────────
     GALLERY STRIP
     ────────────────────────────────────────────── */
  .gallery-strip { padding: 5rem 0 1rem; }
  .strip {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 900px) {
    .strip { grid-template-columns: repeat(5, 1fr); gap: 1.5rem; }
  }
  .strip-item { aspect-ratio: 3 / 4; display: block; }

  /* ──────────────────────────────────────────────
     CTA BAND
     ────────────────────────────────────────────── */
  .cta-band {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
    padding: 5rem 0 6rem;
    border-top: 1px solid var(--color-line);
    margin-top: 5rem;
  }
  @media (min-width: 900px) {
    .cta-band { grid-template-columns: 1.4fr 1fr; gap: 4rem; align-items: end; }
  }
  .cta-band h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    margin-top: 0.75rem;
    max-width: 22ch;
  }
  .cta-band h2 em { color: var(--color-clay); font-style: italic; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>
