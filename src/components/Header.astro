---
import Hamburger from "./Hamburger.tsx";
import Navigation from "./Navigation.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { COMPANY } from "../consts";

export interface Props { is404Page?: boolean; }
const { is404Page = false } = Astro.props;
---

<header class="dhc-header">
  <div class="row">
    {!is404Page && (
      <a href="/" class="brand" aria-label="Dynamic Home Creations — home">
        <span class="mark">D—H—C</span>
        <span class="full">Dynamic Home Creations</span>
      </a>
    )}

    {!is404Page && (
      <nav class="inline" aria-label="Primary">
        <a href="/projects/">Projects</a>
        <a href="/journal/">Journal</a>
        <a href="/gallery/">Gallery</a>
        <a href={`tel:+19085550100`} class="phone">{COMPANY.phone}</a>
      </nav>
    )}

    <div class="controls">
      {!is404Page && (
        <>
          <button id="searchTrigger" class="icon-btn" aria-label="Search" aria-haspopup="dialog">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
          </button>
          <ThemeToggle />
          <div class="mobile-only"><Hamburger client:idle /></div>
        </>
      )}
    </div>
  </div>
  {!is404Page && <Navigation />}
  <div class="hairline mt-6"></div>
  <slot />
</header>

<style>
  .dhc-header { position: relative; padding-top: 0.5rem; }
  .row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex; flex-direction: column; line-height: 1;
    text-decoration: none; color: var(--color-ink);
  }
  .brand .mark {
    font-family: var(--font-fraunces), serif;
    font-weight: 600; font-style: italic;
    font-size: 1.05rem; letter-spacing: 0.2em;
    color: var(--color-clay);
  }
  .brand .full {
    font-family: var(--font-inter), sans-serif;
    font-weight: 500; font-size: 0.78rem;
    letter-spacing: 0.22em; text-transform: uppercase;
    margin-top: 6px; color: var(--color-ink);
  }

  nav.inline {
    display: none;
    gap: 2.2rem;
    font-family: var(--font-inter), sans-serif;
    font-size: 0.82rem; letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  nav.inline a { text-decoration: none; color: var(--color-ink); }
  nav.inline a:hover { color: var(--color-clay); }
  nav.inline a.phone { color: var(--color-clay); letter-spacing: 0.08em; text-transform: none; }
  @media (min-width: 900px) { nav.inline { display: inline-flex; } }

  .controls { display: inline-flex; align-items: center; gap: 0.5rem; }
  .icon-btn {
    background: transparent; border: 0; cursor: pointer;
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--color-ink);
  }
  .icon-btn:hover { color: var(--color-clay); }

  .mobile-only { display: inline-flex; }
  @media (min-width: 900px) { .mobile-only { display: none; } }
</style>
